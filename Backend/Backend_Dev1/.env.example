# Configuración de Base de Datos (Tiger Data / PostgreSQL)
# Opción A: URL completa de conexión
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db?sslmode=require

# Opción B: Variables individuales
DB_HOST=localhost
DB_PORT=5432
DB_NAME=courier_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_SSLMODE=prefer

# Configuración del Generador de Simulación
ORDER_INTERVAL_SECONDS=5
ORDER_MIN_FARE=45.0
ORDER_MAX_FARE=180.0
ORDER_TIME_WINDOW_SECONDS=600

# API Keys (Gemini - Dev 3)
GEMINI_API_KEY=tu_api_key_aqui
